{
	"RASPPI5": {
		"details": "Raspberry Pi 5 SD",
		"type": "3",
		"build": "2102",
		"package": "ext-rooter-rasppi",
		"config": ".config_rasppi5",
		"prescript": "/target/linux/bcm27xx/image/sdcard.sh sd",
		"image1": "openwrt-bcm27xx-bcm2712-rpi-5-ext4-factory.img.gz",
		"image2": "openwrt-bcm27xx-bcm2712-rpi-5-ext4-factory.img",
		"image3": "openwrt-bcm27xx-bcm2712-rpi-5-squashfs-sysupgrade.img.gz",
		"image4": "openwrt-bcm27xx-bcm2712-rpi-5-squashfs-sysupgrade.img",
		"imagepath": "/bcm27xx/bcm2712/",
		"mod": "RaspberryPi-5-SD",
		"ext1": "-ext4.img",
		"ext2": "-squashfs.img",
		"addons": ["readme.pdf"]
	},
	"X3000": {
		"details": "Gl.iNet X3000",
		"type": "1",
		"build": "2305",
		"config": ".config_x3000",
		"image": "openwrt-mediatek-filogic-glinet_gl-x3000-squashfs-sysupgrade.bin",
		"imagepath": "/mediatek/filogic/",
		"mod": "GliNet_X3000",
		"ext": "-upgrade.bin"
	},
	"Z8102": {
		"details": "ZBT Z8102AX V1/V2",
